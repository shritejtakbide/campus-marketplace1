# ====================================================================
# CAMPUS MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your local credentials.
# Never commit your actual .env file to version control.
# ====================================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campus_marketplace

# HTTP Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Optional Frontend Static Directory Override
# FRONTEND_DIR=../frontend

# Security Configuration
BCRYPT_SALT_ROUNDS=12
SESSION_LIFETIME_HOURS=24

# Optional Initial Administrator Bootstrapping
# Set these to securely provision an admin account on next migration run
# INITIAL_ADMIN_EMAIL=admin@yourcampus.edu
# INITIAL_ADMIN_PASSWORD=your_secure_password_min8

# Application Base URL (Phase 5 Authentication Security)
# Validated base URL used for building password recovery and system links.
# Never constructed from untrusted HTTP Host headers.
APP_BASE_URL=http://localhost:3000

# Authentication Security & Rate Limiting (Phase 5)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=30
RECOVERY_RATE_LIMIT_MAX_ATTEMPTS=5
RECOVERY_RATE_LIMIT_WINDOW_MINUTES=15
RESET_RATE_LIMIT_MAX_ATTEMPTS=5
RESET_RATE_LIMIT_WINDOW_MINUTES=15

# SMTP Email Service Configuration (Phase 4 & Phase 5)
# Required for real email OTP delivery and password reset links.
# For Gmail SMTP:
#   1. Set SMTP_HOST=smtp.gmail.com and SMTP_PORT=587 (SMTP_SECURE=false for STARTTLS)
#   2. Set SMTP_USER to your full Gmail address (e.g., student.market@gmail.com)
#   3. IMPORTANT: SMTP_PASS must be a 16-character Google "App Password", NOT your personal Gmail account password.
#      Generate one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Campus Marketplace <no-reply@campus.local>"
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60


