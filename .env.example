# ====================================================================
# CAMPUS MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your local credentials.
# Never commit your actual .env file to version control.
# ====================================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campus_marketplace

# HTTP Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Optional Frontend Static Directory Override
# FRONTEND_DIR=../frontend

# Security Configuration
BCRYPT_SALT_ROUNDS=12
SESSION_LIFETIME_HOURS=24

# Optional Initial Administrator Bootstrapping
# Set these to securely provision an admin account on next migration run
# INITIAL_ADMIN_EMAIL=admin@yourcampus.edu
# INITIAL_ADMIN_PASSWORD=your_secure_password_min8

# SMTP Email Service Configuration (Phase 4)
# Required for real email OTP delivery. Configure using your SMTP server or transactional provider (e.g., SendGrid, Mailgun, Brevo, Gmail App Password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Campus Marketplace <no-reply@campus.local>"
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60


